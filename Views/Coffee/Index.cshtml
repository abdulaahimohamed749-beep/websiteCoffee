@model IEnumerable<websiteCoffee.Models.Coffee.CoffeeItem>

@{
    ViewData["Title"] = "Products Dashboard";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-3">
        <div>
            <h2 class="fw-bold m-0" style="color: #2b1810;">
                <i class="fas fa-coffee text-warning me-2"></i> Maamulka Menu-ka coffee
            </h2>
            <p class="text-muted small m-0 mt-1">Halkan ka maamul (Ku dar, Wax ka beddel ama Tirtir) alaabta cafeteria-ga.</p>
        </div>
        <a asp-action="Create" class="btn btn-dark px-4 py-2 shadow border-0 rounded-pill fw-bold" style="background-color: #c5a880; color: #170d08;">
            <i class="fas fa-plus-circle me-1"></i> Ku dar coffee Cusub
        </a>
    </div>

    <div class="card shadow border-0 rounded-3 overflow-hidden bg-white">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-dark" style="background: linear-gradient(135deg, #2b1810 0%, #170d08 100%);">
                    <tr class="text-uppercase tracking-wider small" style="font-size: 0.8rem; border-bottom: 3px solid #c5a880;">
                        <th class="ps-4">Sawirka / Image</th>
                        <th>Magaca Qaxwada / Name</th>
                        <th>Qiimaha / Price</th>
                        <th class="text-center pe-4">Waxqabad / Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-5 text-muted">
                                <i class="fas fa-folder-open fs-2 d-block mb-2"></i>
                                <span class="fw-bold">Ma jirto wax alaab ah oo hadda ku jirta liiska!</span>
                            </td>
                        </tr>
                    }
                    else
                    {
                        foreach (var item in Model)
                        {
                            <tr class="text-dark transition-all">
                                <td class="ps-4 py-3">
                                    <div class="avatar-box">
                                        <img src="~/images/@item.ImageUrl" alt="@item.Name" class="rounded-3 shadow-sm border" style="width: 65px; height: 65px; object-fit: cover;" />
                                    </div>
                                </td>

                                <td class="fw-bold text-dark fs-6">@item.Name</td>

                                <td class="text-success fw-bold fs-5 font-monospace">$@item.Price.ToString("0.00")</td>

                                <td class="text-center pe-4">
                                    <div class="d-flex justify-content-center gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark rounded-pill px-3 shadow-sm">
                                            <i class="fas fa-edit me-1 text-primary"></i> Edit
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger rounded-pill px-3 shadow-sm" onclick="return confirm('Ma hubtaa inaad tirtirto alaabtan: @item.Name?')">
                                            <i class="fas fa-trash me-1"></i> Delete
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    .table tbody tr {
        transition: background-color 0.2s ease;
    }

        .table tbody tr:hover {
            background-color: rgba(197, 168, 128, 0.08) !important;
        }

    .avatar-box img {
        transition: transform 0.2s ease;
    }

    .avatar-box:hover img {
        transform: scale(1.1);
    }
</style>