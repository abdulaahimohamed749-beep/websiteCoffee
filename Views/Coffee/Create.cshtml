@model websiteCoffee.Models.Coffee.CoffeeItem

@{
    ViewData["Title"] = "Ku dar Qaxwo Cusub";
}

<div class="container mt-5" style="max-width: 600px;">
    <div class="card shadow border-0 rounded-3 p-4 bg-white">
        <div class="text-center mb-4">
            <h3 class="fw-bold" style="color: #2b1810;">
                <i class="fas fa-plus-circle text-success me-2"></i> Ku Dar Qaxwo Cusub
            </h3>
            <p class="text-muted small">Geli macluumaadka qaxwada cusub si loogu daro menu-ga.</p>
            <hr class="mx-auto" style="width: 60px; height: 3px; background-color: #c5a880; border: none;">
        </div>

        <form asp-action="Create" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-bold text-dark">Magaca Qaxwada / Name</label>
                <input asp-for="Name" class="form-control rounded-3" placeholder="Tusaale: Arabica Premium" required />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="form-label fw-bold text-dark">Qiimaha / Price ($)</label>
                <input asp-for="Price" type="number" step="0.01" class="form-control rounded-3 font-monospace" placeholder="0.00" required />
                <span asp-validation-for="Price" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold text-dark">Soo Xulo Sawirka / Choose Image File</label>
                <input type="file" name="ImageFile" class="form-control rounded-3" accept="image/*" required />
                <small class="text-muted d-block mt-1">Fadlan dooro sawir (jpg, jpeg, png) oo kombuyuutarkaaga ku jira.</small>
            </div>

            <div class="d-grid gap-2 mt-4">
                <button type="submit" class="btn btn-dark py-2 shadow-sm rounded-3 fw-bold" style="background-color: #2b1810;">
                    <i class="fas fa-save me-1 text-success"></i> Save Product
                </button>
                <a asp-action="Index" class="btn btn-light py-2 border rounded-3 fw-bold text-secondary">
                    <i class="fas fa-arrow-left me-1"></i> Ku laabo Liiska
                </a>
            </div>
        </form>
    </div>
</div>