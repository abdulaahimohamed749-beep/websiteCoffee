@model websiteCoffee.Models.Coffee.CoffeeItem

@{
    ViewData["Title"] = "Wax ka beddel Qaxwada";
}

<div class="container mt-5" style="max-width: 600px;">
    <div class="card shadow border-0 rounded-3 p-4 bg-white">
        <div class="text-center mb-4">
            <h3 class="fw-bold" style="color: #2b1810;">
                <i class="fas fa-edit text-primary me-2"></i> Wax ka beddel Qaxwada
            </h3>
            <p class="text-muted small">Halkan ka beddel magaca, qiimaha ama sawirka qaxwada dooran.</p>
            <hr class="mx-auto" style="width: 60px; height: 3px; background-color: #c5a880; border: none;">
        </div>

        <form asp-action="Edit" method="post" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="Name" class="form-label fw-bold text-dark">Magaca Qaxwada / Name</label>
                <input asp-for="Name" class="form-control rounded-3" required />
                <span asp-validation-for="Name" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Price" class="form-label fw-bold text-dark">Qiimaha / Price ($)</label>
                <input asp-for="Price" type="number" step="0.01" class="form-control rounded-3 font-monospace" required />
                <span asp-validation-for="Price" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold text-dark">Beddel Sawirka (Haddii aad rabto)</label>

                <div class="d-flex align-items-center gap-3 mb-2 p-2 border rounded bg-light">
                    <img src="~/images/@Model.ImageUrl" alt="@Model.Name" class="rounded shadow-sm" style="width: 50px; height: 50px; object-fit: cover;" />
                    <span class="text-muted small font-monospace">Sawirka Hadda: @Model.ImageUrl</span>
                </div>

                <input type="file" name="ImageFile" class="form-control rounded-3" accept="image/*" />
            </div>

            <div class="d-grid gap-2 mt-4">
                <button type="submit" class="btn btn-dark py-2 shadow-sm rounded-3 fw-bold" style="background-color: #2b1810;">
                    <i class="fas fa-sync-alt me-1 text-primary"></i> Update Product
                </button>
                <a asp-action="Index" class="btn btn-light py-2 border rounded-3 fw-bold text-secondary">
                    Huri iska dhaaf
                </a>
            </div>
        </form>
    </div>
</div>